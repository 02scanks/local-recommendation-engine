{
  "manifest_version": 3,
  "name": "Local Browsing Tracker",
  "version": "1.0.0",
  "description": "Sends browsing activity to local personalization engine",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
  "<all_urls>",
  "http://localhost:5013/*"
  ],
    "background": {
    "scripts": ["background.js"]
  }
}
